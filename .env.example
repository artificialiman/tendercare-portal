# Same Supabase project as tendercare-teacher — copy its values here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — from Supabase project settings > API > service_role key.
# NEVER expose this with a PUBLIC_ prefix or import it from a .svelte file.
# Used only by src/lib/server/supabaseAdmin.ts to verify result-page
# passwords against portal_credentials, which RLS hides from the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# THE student password -- one value for every student's result page. Set it here
# (local) and in the deployment's environment variables (Vercel). Change it in
# both places to change every student's login at once; nothing else to re-run.
# While this is unset, the portal falls back to the older per-row check against
# portal_credentials in Supabase.
STUDENT_LOGIN_PASSWORD=
